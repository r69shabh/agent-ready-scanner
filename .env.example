# Copy to .env and fill in (never commit .env). Loaded by check_providers/scan
# if you `pip install python-dotenv` and `set -a; source .env; set +a`.
# NVIDIA Build — free: https://build.nvidia.com (credits to start)
# Copy the exact model ID from the model page; override default if 404:
NVIDIA_API_KEY=
# NVIDIA_MODEL=meta/llama-3.1-8b-instruct
# GroqCloud — free tier: https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# Optional legacy:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
